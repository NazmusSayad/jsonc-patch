{
  "name": "jsonc-patch",
  "version": "0.0.4",
  "description": "Apply object changes to a JSON / JSONC string while preserving formatting, comments, and whitespace.",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "tc": "tsc --noEmit --watch",
    "build": "tsdown --config ./tsdown.config.ts",
    "dev": "concurrently --names \"R,T\" --prefix-colors \"blue.dim,magenta.dim\" \"tsdown --config ./tsdown.config.ts --watch\" \"tsc --noEmit --watch\"",
    "start": "tsx --watch ./src/index.ts"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts",
        "./dist/index.d.cts"
      ]
    }
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rolldown": "^1.0.2",
    "tsdown": "^0.15.9",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "jsonc",
    "json",
    "patch",
    "diff",
    "json-patch",
    "comments",
    "formatting",
    "jsonc-parser",
    "fast-json-patch"
  ],
  "license": "MIT",
  "author": "NazmusSayad",
  "homepage": "https://github.com/NazmusSayad/jsonc-patch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazmusSayad/jsonc-patch.git"
  },
  "bugs": {
    "url": "https://github.com/NazmusSayad/jsonc-patch/issues"
  }
}
